    "ee322e5bb0fb346e66a964cf7847c3966900ba8ad9b4d5b97be68a26ee3e6907": "def priority(op):\n    if op[\"uses_port\"]:\n        return op[\"tail\"]\n    return 0\n\n",
    "db887d6ba28289350918383906a42ae0baa57238c50a857e760900935b2bb3a9": "def priority(op):\n    if not op[\"uses_port\"] and op[\"latency\"] == 0:\n        return 2\n    if op[\"uses_port\"]:\n        tail = op[\"tail\"]\n        return tail / (1 + abs(tail))\n    return 0\n\n",
