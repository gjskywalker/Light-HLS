    "0464bb0101816bf561a7291ac4e0f526583a5e14c4e93243f2ade5356eb9139d": "def priority(op):\n    if op[\"uses_port\"]:\n        return 0\n    if op[\"latency\"] > 0:\n        return min(1000000000, max(0, op[\"tail\"]))\n    return 0\n\n",
    "ba5dfe5651fba157fd112b437a9c46791613aede92889ec97b0fb748268e3fbe": "def priority(op):\n    score = float(op[\"tail\"])\n    if op[\"uses_port\"] and op[\"competing_requests\"] > 0:\n        requests = max(0, op[\"downstream_requests\"])\n        score = score + 0.25 * requests / (1 + requests)\n    return score\n\n",
    "ff1e2f721253a8eb735cbd6b42f26acfee97e4234f13b46ea6f37d63a15d2ba3": "def priority(op):\n    score = 0.0\n    if not op[\"uses_port\"]:\n        score = float(op[\"tail\"])\n    return score\n\n",
    "018e962ed6864e01ce27f9afb0f694ab9b8b30575b61ea0fd1c4fe8080da8912": "def priority(op):\n    score = float(op[\"tail\"])\n    if op[\"uses_port\"] and op[\"competing_requests\"] > 0:\n        requests = max(0.0, float(op[\"downstream_requests\"]))\n        score = score + 0.001 * requests / (1.0 + requests)\n    return score\n\n",
    "a55aae8e42e932653e450f2ae8463d3d330874e53fc70f4010776b940fc89666": "def priority(op):\n    if op[\"latency\"] == 0 and not op[\"uses_port\"]:\n        return 1.0 + max(0.0, float(op[\"tail\"]))\n    return 0.0\n\n",
